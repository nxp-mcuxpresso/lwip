                endmenu

                menu "Heap and memory pools"
                    config MEM_LIBC_MALLOC
                        bool "MEM_LIBC_MALLOC"
                        default n
                        help
                            No prefix in generated macro
                            MEM_LIBC_MALLOC==1: Use malloc/free/realloc provided by your C-library
                            instead of the lwip internal allocator. Can save code size if you
                            already use it. Specialized case of MEM_CUSTOM_ALLOCATOR.

                    config MEM_CUSTOM_ALLOCATOR
                        bool "MEM_CUSTOM_ALLOCATOR"
                        default MEM_LIBC_MALLOC
                        help
                            No prefix in generated macro
                            MEM_CUSTOM_ALLOCATOR==1: Use malloc/free/realloc provided by a custom
                            implementation instead of the lwip internal allocator. Can save code size if
                            you already use it. If enabled, you have to define those functions:
                            #define MEM_CUSTOM_FREE   my_free
                            #define MEM_CUSTOM_MALLOC my_malloc
                            #define MEM_CUSTOM_CALLOC my_calloc

                    config MEMP_MEM_MALLOC
                        bool "MEMP_MEM_MALLOC"
                        default n
                        help
                            No prefix in generated macro
                            MEMP_MEM_MALLOC==1: Use mem_malloc/mem_free instead of the lwip pool allocator.
                            Especially useful with MEM_LIBC_MALLOC but handle with care regarding execution
                            speed (heap alloc can be much slower than pool alloc) and usage from interrupts
                            (especially if your netif driver allocates PBUF_POOL pbufs for received frames
                            from interrupt)!
                            ATTENTION: Currently, this uses the heap for ALL pools (also for private pools,
                            not only for internal pools defined in memp_std.h)!

                    config MEMP_MEM_INIT
                        bool "MEMP_MEM_INIT"
                        default n
                        help
                            No prefix in generated macro
                            MEMP_MEM_INIT==1: Force use of memset to initialize pool memory.
                            Useful if pool are moved in uninitialized section of memory. This will ensure
                            default values in pcbs struct are well initialized in all conditions.

                    config MEM_ALIGNMENT
                        int "MEM_ALIGNMENT"
                        default 1
                        help
                            No prefix in generated macro
                            type unsigned
                            MEM_ALIGNMENT: should be set to the alignment of the CPU
                               4 byte alignment -> #define MEM_ALIGNMENT 4
                               2 byte alignment -> #define MEM_ALIGNMENT 2

                    config MEM_SIZE
                        int "MEM_SIZE"
                        default 1600
                        help
                            No prefix in generated macro
                            type unsigned
                            MEM_SIZE: the size of the heap memory. If the application will send
                            a lot of data that needs to be copied, this should be set high.

                    config MEMP_OVERFLOW_CHECK
                        int "MEMP_OVERFLOW_CHECK"
                        default 0
                        help
                            No prefix in generated macro
                            type unsigned
                            MEMP_OVERFLOW_CHECK: memp overflow protection reserves a configurable
                            amount of bytes before and after each memp element in every pool and fills
                            it with a prominent default value.
                               MEMP_OVERFLOW_CHECK == 0 no checking
                               MEMP_OVERFLOW_CHECK == 1 checks each element when it is freed
                               MEMP_OVERFLOW_CHECK >= 2 checks each element in every pool every time
                                 memp_malloc() or memp_free() is called (useful but slow!)

                    config MEMP_SANITY_CHECK
                        bool "MEMP_SANITY_CHECK"
                        default n
                        help
                            No prefix in generated macro
                            MEMP_SANITY_CHECK==1: run a sanity check after each memp_free() to make
                            sure that there are no cycles in the linked lists.

                    config MEM_OVERFLOW_CHECK
                        int "MEM_OVERFLOW_CHECK"
                        default 0
                        help
                            No prefix in generated macro
                            type unsigned
                            MEM_OVERFLOW_CHECK: mem overflow protection reserves a configurable
                            amount of bytes before and after each heap allocation chunk and fills
                            it with a prominent default value.
                               MEM_OVERFLOW_CHECK == 0 no checking
                               MEM_OVERFLOW_CHECK == 1 checks each element when it is freed
                               MEM_OVERFLOW_CHECK >= 2 checks all heap elements every time
                                 mem_malloc() or mem_free() is called (useful but slow!)

                    config MEM_SANITY_CHECK
                        bool "MEM_SANITY_CHECK"
                        default n
                        help
                            No prefix in generated macro
                            MEM_SANITY_CHECK==1: run a sanity check after each mem_free() to make
                            sure that the linked list of heap elements is not corrupted.

                    config MEM_USE_POOLS
                        bool "MEM_USE_POOLS"
                        default n
                        help
                            No prefix in generated macro
                            MEM_USE_POOLS==1: Use an alternative to malloc() by allocating from a set
                            of memory pools of various sizes. When mem_malloc is called, an element of
                            the smallest pool that can provide the length needed is returned.
                            To use this, MEMP_USE_CUSTOM_POOLS also has to be enabled.

                    config MEM_USE_POOLS_TRY_BIGGER_POOL
                        bool "MEM_USE_POOLS_TRY_BIGGER_POOL"
                        default n
                        help
                            No prefix in generated macro
                            MEM_USE_POOLS_TRY_BIGGER_POOL==1: if one malloc-pool is empty, try the next
                            bigger pool - WARNING: THIS MIGHT WASTE MEMORY but it can make a system more
                            reliable.

                    config MEMP_USE_CUSTOM_POOLS
                        bool "MEMP_USE_CUSTOM_POOLS"
                        default n
                        help
                            No prefix in generated macro
                            MEMP_USE_CUSTOM_POOLS==1: whether to include a user file lwippools.h
                            that defines additional pools beyond the "standard" ones required
                            by lwIP. If you set this to 1, you must have lwippools.h in your
                            include path somewhere.

                    config LWIP_ALLOW_MEM_FREE_FROM_OTHER_CONTEXT
                        bool "LWIP_ALLOW_MEM_FREE_FROM_OTHER_CONTEXT"
                        default y if (NO_SYS && MCUX_COMPONENT_middleware.lwip.enet_ethernetif && MCUX_HAS_COMPONENT_driver.lpc_enet)
                        default y if (NO_SYS && MCUX_COMPONENT_middleware.lwip.mcx_ethernetif)
                        default n
                        help
                            No prefix in generated macro
                            Set this to 1 if you want to free PBUF_RAM pbufs (or call mem_free()) from
                            interrupt context (or another context that doesn't allow waiting for a
                            semaphore).
                            If set to 1, mem_malloc will be protected by a semaphore and SYS_ARCH_PROTECT,
                            while mem_free will only use SYS_ARCH_PROTECT. mem_malloc SYS_ARCH_UNPROTECTs
                            with each loop so that mem_free can run.

                            ATTENTION: As you can see from the above description, this leads to dis-/
                            enabling interrupts often, which can be slow! Also, on low memory, mem_malloc
                            can need longer.

                            If you don't want that, at least for NO_SYS=0, you can still use the following
                            functions to enqueue a deallocation call which then runs in the tcpip_thread
                            context:
                            - pbuf_free_callback(p);
                            - mem_free_callback(m);
                endmenu

