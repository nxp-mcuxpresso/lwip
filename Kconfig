            depends on MCUX_COMPONENT_component.rt_gpio_adapter || \
                       MCUX_COMPONENT_component.lpc_gpio_adapter || \
                       MCUX_COMPONENT_component.igpio_adapter || \
                       MCUX_COMPONENT_component.rgpio_adapter || \
                       MCUX_COMPONENT_component.gpio_adapter || \
                       MCUX_COMPONENT_driver.siul2
            help
                "Kinetis enet ethernet interface"

        config MCUX_COMPONENT_middleware.lwip.kinetis_ethernetif.non_generated_lwipopts
            bool
            default y
            depends on MCUX_COMPONENT_middleware.lwip.kinetis_ethernetif
            depends on !MCUX_PRJSEG_middleware.lwip.generated_config
            help
