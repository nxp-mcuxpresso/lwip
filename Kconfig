    if MCUX_PRJSEG_middleware.lwip.generated_config
        menu "Code inserted into lwipopts.h before include of lwipopts_gen.h"
            config LWIP_OPT_H_CODE_LINE_1
                string "LWIP_OPT_H_CODE_LINE_1"
                default ""
                help
                    No prefix in generated macro
                    This allows to inject source code in opt.h before lwipopts.h is included.
                    It can be used for example to provide function signatures for
                    the functions configured here, like LWIP_RAND, because it is not
                    possible to place signatures here.

            config LWIP_OPT_H_CODE_LINE_2
