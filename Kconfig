                        string
                        default LWIP_HOOK_SOCKETS_GETSOCKOPT_CUSTOM(s, sock, level, optname, optval, optlen, err)
                        depends on LWIP_HOOK_SOCKETS_GETSOCKOPT_CUSTOM(s, sock, level, optname, optval, optlen, err) != ""
                        help
                            No prefix in generated macro

                    config LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE_CUSTOM(name, addr, addrtype, err)
                        string "LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE(name, addr, addrtype, err)"
                        default ""
                        help
                            No prefix in generated macro
                            LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE(name, addr, addrtype, err)
                            Called from netconn APIs (not usable with callback apps) allowing an
                            external DNS resolver (which uses sequential API) to handle the query.
                            Signature:\code{.c}
                              int my_hook(const char *name, ip_addr_t *addr, u8_t addrtype, err_t *err)
                            \endcode
                            Arguments:
                            - name: hostname to resolve
                            - addr: output host address
                            - addrtype: type of address to query
                            - err: output error
                            Return values:
                            - 0: Hook has not consumed hostname query, query continues into DNS module
                            - != 0: Hook has consumed the query

                            err must also be checked to determine if the hook consumed the query, but
                            the query failed

                    config LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE(name, addr, addrtype, err)
                        string
                        default LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE_CUSTOM(name, addr, addrtype, err)
                        depends on LWIP_HOOK_NETCONN_EXTERNAL_RESOLVE_CUSTOM(name, addr, addrtype, err) != ""
                        help
                            No prefix in generated macro
                endmenu
            endmenu

